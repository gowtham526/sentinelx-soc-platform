# SentinelX SOC Platform — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ─── Production Database Configuration ───────────────────────
# Choose 'mysql' for external/production MySQL server or leave blank for embedded SQL engine.
DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sentinelx_db

# ─── Threat Intelligence API Keys ───────────────────────────
# VirusTotal: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSE_API_KEY=

# ─── Password Hashing ──────────────────────────────────────
# DEPRECATED: bcrypt is now used with per-user salts.
# This key is retained only for migration compatibility.
PASSWORD_SALT=

# ─── Suricata Integration ──────────────────────────────────
SURICATA_EVE_JSON_PATH=
SURICATA_HOST_LABEL=
SURICATA_UNIX_SOCKET=

# ─── Wazuh Integration ─────────────────────────────────────
WAZUH_INDEXER_HOST=
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=
WAZUH_INDEXER_VERIFY_SSL=false
WAZUH_POLL_SECONDS=15
WAZUH_MIN_LEVEL=3
WAZUH_MANAGER_HOST=
WAZUH_MANAGER_PORT=55000
WAZUH_API_USER=
WAZUH_API_PASS=

# ─── AI Triage (Anthropic Claude) ──────────────────────────
ANTHROPIC_API_KEY=
AI_TRIAGE_MODEL=claude-haiku-4-5-20251001
AI_REPORT_MODEL=claude-sonnet-5

# ─── Email Notifications (SMTP) ────────────────────────────
# Set NOTIFY_MIN_SEVERITY to DISABLED to suppress all email.
# Valid: LOW, MEDIUM, HIGH, CRITICAL, DISABLED
NOTIFY_MIN_SEVERITY=DISABLED
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# ─── Webhook Notifications ─────────────────────────────────
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# ─── SLA Escalation ────────────────────────────────────────
SLA_CRITICAL_MINUTES=15

# ─── IOC Feeds ──────────────────────────────────────────────
IOC_FEEDS_ENABLED=true
IOC_REFRESH_MINUTES=60

# ─── YARA Rules ─────────────────────────────────────────────
YARA_ENABLED=true
YARA_RULES_DIR=
YARA_MAX_FILE_MB=50

# ─── Canary / Honeytokens ──────────────────────────────────
CANARY_FILE_PATHS=
CANARY_ACCOUNT_NAME=

# ─── Anomaly Detection ─────────────────────────────────────
ANOMALY_WINDOW_MINUTES=10
ANOMALY_MIN_SAMPLES=5
ANOMALY_Z_HIGH=4
ANOMALY_Z_MEDIUM=2.5

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins (default: localhost only)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# ─── Server Bind ────────────────────────────────────────────
# Default: 127.0.0.1 (local only). Set to 0.0.0.0 ONLY if you
# explicitly need LAN access and understand the security implications.
BIND_HOST=127.0.0.1
